# KilimoOrbit Sentinel — environment configuration
# Get a FREE Gemini API key (no credit card): https://aistudio.google.com/apikey
# Paste your key after the = sign (no quotes, no semicolon, no trailing comment):
GEMINI_API_KEY=your_gemini_api_key_here


# Optional overrides
# APEX_MODEL=gemini-2.5-flash
# APEX_MOCK=1          # force offline deterministic engine (no API calls)
# PORT=4517            # Mission Control dashboard port

# Welcome email on sign-in (POST /api/signin). Leave unset to run in
# SIMULATED mode (the email is logged to the server console instead).
# Either a single connection URL…
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# …or discrete settings (e.g. Gmail app password, Brevo, Mailtrap):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM="KilimoOrbit Sentinel <you@gmail.com>"

# Farm weather (GET /api/weather). Default: a deterministic SAMPLE forecast,
# labelled as sample data in the apps. Set to use real forecasts from
# Open-Meteo (free, no key); any failure falls back to SAMPLE.
# WEATHER_PROVIDER=open-meteo

# Farm news (GET /api/news): read from public RSS feeds (The Standard, Kilimo
# News, Google News for the farmer's county). Needs outbound internet on the
# server; without it, labelled SAMPLE tips are served instead.

# Farm shows (GET /api/events, POST /api/events/book): bookings and their
# email reminders are kept in this file (default data/events_bookings.json).
# Confirmation and reminder emails use the SMTP settings above; without SMTP
# they are SIMULATED (logged) and the calendar alarm is the reminder.
# EVENTS_STORE_PATH=data/events_bookings.json
