# KilimoOrbit Sentinel — environment configuration
# Get a FREE Gemini API key (no credit card): https://aistudio.google.com/apikey
# Paste your key after the = sign (no quotes, no semicolon, no trailing comment):
GEMINI_API_KEY=your_gemini_api_key_here


# Optional overrides
# APEX_MODEL=gemini-2.5-flash
# APEX_MOCK=1          # force offline deterministic engine (no API calls)
# PORT=4517            # Mission Control dashboard port

# Email (SMTP): the welcome email on sign-in (POST /api/signin), the farm-show
# booking confirmation and its reminder emails (POST /api/events/book), and
# the farmer's records digest (POST /api/records/digest). Leave unset to run
# in SIMULATED mode (each email is logged to the server console instead).
# Either a single connection URL…
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# …or discrete settings (e.g. Gmail app password, Brevo, Mailtrap):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM="KilimoOrbit Sentinel <you@gmail.com>"

# Farm weather (GET /api/weather). Default: real 7-day forecasts from
# Open-Meteo (free, no key, needs outbound internet), cached 30 minutes per
# county; any failure falls back to a deterministic SAMPLE forecast labelled
# as sample data in the apps. Set to "sample" to force the sample (tests, demos).
# WEATHER_PROVIDER=sample

# Farm news (GET /api/news): read from public RSS feeds (The Standard, Kilimo
# News, Google News for the farmer's county). Needs outbound internet on the
# server; without it, labelled SAMPLE tips are served instead.

# Farm shows (GET /api/events, POST /api/events/book): bookings and their
# email reminders (N days before the show and the morning it starts) are kept
# in this file (default data/events_bookings.json). Confirmation and reminder
# emails use the SMTP settings above; without SMTP they are SIMULATED (logged)
# and the calendar alarm is the reminder.
# EVENTS_STORE_PATH=data/events_bookings.json

# Mail to the farmer (POST /api/records/digest, /api/brief, /api/alerts/email):
# the app composes the records digest, the morning brief and a price alert in
# the farmer's language; the server lays them out and emails them (SMTP above,
# SIMULATED otherwise). With SMTP, an address must first be confirmed through
# the link in the welcome email (src/agro/mail.js): confirmed addresses are
# kept in MAIL_STORE_PATH, the link is signed with MAIL_SECRET (a random one
# is kept in data/mail_secret when unset) and points at PUBLIC_URL (else the
# address the request came in on). Each address gets at most 40 such emails
# and 5 confirmation emails a day, and links in farmer text are removed.
# PUBLIC_URL=https://your-sentinel.onrender.com
# MAIL_SECRET=change-me-to-a-long-random-string
# MAIL_STORE_PATH=data/mail_confirmed.json
